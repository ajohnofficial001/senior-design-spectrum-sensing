- name: fusion_logger
  id: epy_block
  parameters:
    _source_code: "# SPDX-License-Identifier: GPL-3.0\n\"\"\"Source code also embedded in full_simulation.grc.\
      \ Ledger is a local mock.\"\"\"\nimport csv\nimport hashlib\nimport json\nfrom pathlib import Path\n\
      import uuid\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    \"\"\
      \"Window-end decisions, OR/AND fusion, metrics and hash-linked local ledger.\"\"\"\n\n    def __init__(self,\
      \ sample_rate=2000000, segment_samples=20000,\n                 window_samples=1000, guard_samples=2000,\n\
      \                 threshold1=0.05, threshold2=0.05, fusion_rule='OR',\n                 output_root='simulation/generated',\
      \ config=None):\n        gr.sync_block.__init__(self, name='Fusion, metrics and MOCK ledger',\n\
      \                               in_sig=[np.float32] * 5, out_sig=None)\n        if window_samples\
      \ < 1 or not window_samples <= guard_samples < segment_samples:\n            raise ValueError('Require\
      \ window <= guard < segment_samples')\n        if sample_rate <= 0 or min(threshold1, threshold2)\
      \ < 0:\n            raise ValueError('Invalid sample rate or threshold')\n        if fusion_rule\
      \ not in ('OR', 'AND'):\n            raise ValueError('fusion_rule must be OR or AND')\n       \
      \ self.fs, self.segment = float(sample_rate), int(segment_samples)\n        self.window, self.guard\
      \ = int(window_samples), int(guard_samples)\n        self.thresholds, self.rule = (threshold1, threshold2),\
      \ fusion_rule\n        self.root, self.config = output_root, dict(config or {})\n        self.position\
      \ = 0\n        self.counts = {name: dict(tp=0, fp=0, tn=0, fn=0)\n                       for name\
      \ in ('rx1', 'rx2', 'OR', 'AND')}\n        self.scenarios = {str(i): {name: dict(tp=0, fp=0, tn=0,\
      \ fn=0)\n                                  for name in self.counts} for i in range(4)}\n       \
      \ self.previous_hash = '0' * 64\n        self.records = 0\n        self.csv_file = self.ledger_file\
      \ = None\n        self.directory = None\n\n    def start(self):\n        # GRC introspects constructors:\
      \ create files only when execution starts.\n        self.directory = Path(self.root) / ('full_sim_'\
      \ + uuid.uuid4().hex)\n        self.directory.mkdir(parents=True, exist_ok=False)\n        config\
      \ = dict(self.config, sample_rate=self.fs, segment_samples=self.segment,\n                     \
      \ window_samples=self.window, guard_samples=self.guard,\n                      thresholds=self.thresholds,\
      \ fusion_rule=self.rule,\n                      ledger_mode='LOCAL_MOCK_NOT_BLOCKCHAIN')\n     \
      \   encoded = json.dumps(config, sort_keys=True, separators=(',', ':'))\n        self.config_hash\
      \ = hashlib.sha256(encoded.encode()).hexdigest()\n        (self.directory / 'config.json').write_text(encoded\
      \ + '\\n', encoding='utf-8')\n        self.csv_file = (self.directory / 'observations.csv').open('w',\
      \ newline='', encoding='utf-8')\n        self.writer = csv.writer(self.csv_file)\n        self.writer.writerow(['sample_index',\
      \ 'sample_time_s', 'scenario', 'truth',\n                              'rx1_filtered', 'rx2_filtered',\
      \ 'rx1_full', 'rx2_full',\n                              'rx1_decision', 'rx2_decision', 'OR', 'AND',\
      \ 'selected'])\n        self.ledger_file = (self.directory / 'mock_ledger.jsonl').open('w', encoding='utf-8')\n\
      \        print('Simulation outputs:', self.directory)\n        return True\n\n    @staticmethod\n\
      \    def update(counts, decision, truth):\n        key = ('tp' if truth else 'fp') if decision else\
      \ ('fn' if truth else 'tn')\n        counts[key] += 1\n\n    def work(self, input_items, output_items):\n\
      \        n = len(input_items[0])\n        # Input order: filtered RX1/RX2, unfiltered RX1/RX2, ideal\
      \ truth.\n        for local in range((-self.position + self.window - 1) % self.window, n, self.window):\n\
      \            index = self.position + local\n            if index % self.segment < self.guard:\n\
      \                continue  # Exclude FIR/window transients after every scenario change.\n      \
      \      powers = [float(stream[local]) for stream in input_items[:4]]\n            if not np.all(np.isfinite(powers)):\n\
      \                raise ValueError('Nonfinite power observation')\n            truth = int(input_items[4][local]\
      \ >= 0.5)\n            decisions = [int(powers[i] > self.thresholds[i]) for i in range(2)]\n   \
      \         either, both = int(any(decisions)), int(all(decisions))\n            scenario = (index\
      \ // self.segment) % 4\n            for name, decision in zip(self.counts, decisions + [either,\
      \ both]):\n                self.update(self.counts[name], decision, truth)\n                self.update(self.scenarios[str(scenario)][name],\
      \ decision, truth)\n            selected = either if self.rule == 'OR' else both\n            self.writer.writerow([index,\
      \ index / self.fs, scenario, truth,\n                                  *powers, *decisions, either,\
      \ both, selected])\n            record = dict(sequence=self.records, sample_index=index, truth=truth,\n\
      \                          scenario=int(scenario), powers=powers, decisions=decisions,\n       \
      \                   fusion_rule=self.rule, fused=selected, config_sha256=self.config_hash,\n   \
      \                       previous_hash=self.previous_hash, mode='LOCAL_MOCK_NOT_BLOCKCHAIN')\n  \
      \          canonical = json.dumps(record, sort_keys=True, separators=(',', ':'))\n            self.previous_hash\
      \ = hashlib.sha256(canonical.encode()).hexdigest()\n            record['hash'] = self.previous_hash\n\
      \            self.ledger_file.write(json.dumps(record, sort_keys=True) + '\\n')\n            self.records\
      \ += 1\n        self.position += n\n        return n\n\n    @staticmethod\n    def metrics(counts):\n\
      \        tp, fp, tn, fn = (counts[k] for k in ('tp', 'fp', 'tn', 'fn'))\n        return dict(counts,\
      \ probability_detection=tp / (tp + fn) if tp + fn else None,\n                    probability_false_alarm=fp\
      \ / (fp + tn) if fp + tn else None)\n\n    def stop(self):\n        if self.directory is not None:\n\
      \            expected = int(self.config.get('expected_samples', 0))\n            summary = dict(samples_consumed=self.position,\
      \ expected_samples=expected,\n                           completed=(self.position == expected) if\
      \ expected else None,\n                           observations=self.records, final_mock_hash=self.previous_hash,\n\
      \                           metrics={k: self.metrics(v) for k, v in self.counts.items()},\n    \
      \                       per_scenario={s: {k: self.metrics(v) for k, v in nodes.items()}\n      \
      \                                   for s, nodes in self.scenarios.items()},\n                 \
      \          limitations=['Simulation only; no RF validation',\n                                 \
      \       'Ideal synchronized reporting, no packet loss or network model',\n                     \
      \                   'Local hash chain, no consensus, contract or blockchain network',\n        \
      \                                'Window observations overlap in filter memory; no confidence intervals'])\n\
      \            (self.directory / 'summary.json').write_text(json.dumps(summary, indent=2) + '\\n',\
      \ encoding='utf-8')\n            self.csv_file.close()\n            self.ledger_file.close()\n \
      \       return True\n"
    sample_rate: samp_rate
    segment_samples: segment_samples
    window_samples: window_samples
    guard_samples: guard_samples
    threshold1: threshold1
    threshold2: threshold2
    fusion_rule: fusion_rule
    output_root: output_root
    config: run_config
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1300
    - 680
    rotation: 0
    state: enabled
    _io_cache: ('Fusion, metrics and MOCK ledger', 'blk', [('sample_rate', '2000000'), ('segment_samples',
      '20000'), ('window_samples', '1000'), ('guard_samples', '2000'), ('threshold1', '0.05'), ('threshold2',
      '0.05'), ('fusion_rule', "'OR'"), ('output_root', "'simulation/generated'"), ('config', 'None')],
      [('0', 'float', 1), ('1', 'float', 1), ('2', 'float', 1), ('3', 'float', 1), ('4', 'float', 1)],
      [], 'Window-end decisions, OR/AND fusion, metrics and hash-linked local ledger.', [])
