- name: scenario_source
  id: epy_block
  parameters:
    _source_code: "# SPDX-License-Identifier: GPL-3.0\n\"\"\"Source code also embedded in full_simulation.grc;\
      \ no device access.\"\"\"\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Finite two-node scenario source. Ports: RX1 complex, RX2 complex, truth float.\"\"\"\n\
      \n    def __init__(self, sample_rate=2000000, segment_samples=20000, cycles=10,\n              \
      \   tone_offset=400000, signal_amplitude=0.0002,\n                 interference_offset=600000, interference_amplitude=0.002,\n\
      \                 node2_gain=0.65, noise1=0.001, noise2=0.0012, seed=101):\n        gr.sync_block.__init__(self,\
      \ name='Finite two-node scenarios', in_sig=None,\n                               out_sig=[np.complex64,\
      \ np.complex64, np.float32])\n        if sample_rate <= 0 or segment_samples < 1 or cycles < 1:\n\
      \            raise ValueError('Positive sample rate, segment length and cycles required')\n    \
      \    if max(abs(tone_offset), abs(interference_offset)) >= sample_rate / 2:\n            raise ValueError('Tone\
      \ and interference offsets must be below Nyquist')\n        if min(signal_amplitude, interference_amplitude,\
      \ node2_gain, noise1, noise2) < 0:\n            raise ValueError('Amplitudes and gains must be nonnegative')\n\
      \        self.fs = float(sample_rate)\n        self.segment = int(segment_samples)\n        self.total\
      \ = self.segment * 4 * int(cycles)\n        self.offset, self.amplitude = tone_offset, signal_amplitude\n\
      \        self.interference_offset = interference_offset\n        self.interference_amplitude = interference_amplitude\n\
      \        self.gain2 = node2_gain\n        self.noise = (noise1, noise2)\n        self.rng = (np.random.default_rng(int(seed)),\
      \ np.random.default_rng(int(seed) + 1))\n        self.position = 0\n\n    def work(self, input_items,\
      \ output_items):\n        n = min(len(output_items[0]), self.total - self.position)\n        if\
      \ n <= 0:\n            return -1\n        index = np.arange(self.position, self.position + n, dtype=np.int64)\n\
      \        scenario = (index // self.segment) % 4\n        occupied = (scenario % 2).astype(np.float32)\n\
      \        interferer_on = scenario >= 2\n        wanted = self.amplitude * occupied * np.exp(2j *\
      \ np.pi * self.offset * index / self.fs)\n        unwanted = self.interference_amplitude * interferer_on\
      \ * np.exp(\n            2j * np.pi * self.interference_offset * index / self.fs)\n        for node,\
      \ gain in enumerate((1.0, self.gain2)):\n            # Interleaved I/Q draws give identical samples\
      \ across scheduler chunk sizes.\n            iq = self.rng[node].standard_normal((n, 2)) * self.noise[node]\n\
      \            output_items[node][:n] = gain * (wanted + unwanted) + iq[:, 0] + 1j * iq[:, 1]\n  \
      \      output_items[2][:n] = occupied\n        self.position += n\n        return n\n"
    sample_rate: samp_rate
    segment_samples: segment_samples
    cycles: cycles
    tone_offset: tone_offset
    signal_amplitude: signal_amplitude
    interference_offset: interference_offset
    interference_amplitude: interference_amplitude
    node2_gain: node2_gain
    noise1: noise1
    noise2: noise2
    seed: seed
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 32
    - 560
    rotation: 0
    state: enabled
    _io_cache: '(''Finite two-node scenarios'', ''blk'', [(''sample_rate'', ''2000000''), (''segment_samples'',
      ''20000''), (''cycles'', ''10''), (''tone_offset'', ''400000''), (''signal_amplitude'', ''0.0002''),
      (''interference_offset'', ''600000''), (''interference_amplitude'', ''0.002''), (''node2_gain'',
      ''0.65''), (''noise1'', ''0.001''), (''noise2'', ''0.0012''), (''seed'', ''101'')], [], [(''0'',
      ''complex'', 1), (''1'', ''complex'', 1), (''2'', ''float'', 1)], ''Finite two-node scenario source.
      Ports: RX1 complex, RX2 complex, truth float.'', [])'
